{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jarvis-cloud-phase2",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jarvis-reminders",
      "database_id": "f585c748-f7ec-4e32-9191-8d4a4d5341fd"
    }
  ],
  "keep_vars": true,
  "ai": {
    "binding": "AI"
  }
}
