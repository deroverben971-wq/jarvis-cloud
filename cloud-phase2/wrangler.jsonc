{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jarvis-cloud-phase2",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jarvis-reminders",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "keep_vars": true,
  "ai": {
    "binding": "AI"
  }
}
